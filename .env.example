MYSQL_USER=root
MYSQL_PASSWORD=replace-with-database-password
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DB=global_s_p_ecom
SECRET_KEY=replace-with-a-long-random-secret

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_PAYMENT_CURRENCY=INR
USD_TO_INR_RATE=83.00

# Used only when the admin seeder creates a missing administrator.
# Existing administrator passwords are never overwritten by the seeder.
ADMIN_NAME=Admin GSE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Admin media uploads. AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are read by boto3.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-with-bucket-name
AWS_S3_REGION=ap-south-1
# Set this to a CloudFront/custom public base URL when available.
AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
AWS_S3_UPLOAD_PREFIX=admin-uploads
ADMIN_IMAGE_MAX_BYTES=10485760
